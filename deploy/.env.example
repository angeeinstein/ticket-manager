# Copy to /opt/ticket-checker/.env and edit. Loaded by backend/config.py.

# Access control is handled by Cloudflare Access in front of the hostname — there is no
# in-app token. Keep the service reachable only via the tunnel / Access.

# Date the time slots belong to (slots in the PDFs are only HH:MM). ISO format.
EVENT_DATE=2026-06-20

# Bind address/port. Keep on localhost; Cloudflare Tunnel connects to it.
HOST=127.0.0.1
PORT=8080

# --- Settings seeded on first run only. After that the values set in the phone app win
# --- (they sync to the server), so these are just the initial defaults.
# Grace minutes that widen each slot.
GRACE_BEFORE_MINUTES=0
GRACE_AFTER_MINUTES=0
# Max riders the cable car handles per window (0 = unlimited / not set).
MAX_CAPACITY_PER_SLOT=0
# Window length in minutes (also the ticket slot length) used for capacity stats.
SLOT_LENGTH_MINUTES=15
# Walk-up mode: when true, scanning an unknown barcode records it (one-time use) instead of
# rejecting it — lets the event run with NO imported ticket data. Toggle live from the phone.
WALKUP_MODE=false

# Watched-folder ingestion.
WATCH_ENABLED=true
WATCH_INTERVAL_SECONDS=10

# Paths (defaults are fine for the install layout).
# DB_PATH=/opt/ticket-checker/data/tickets.db
# INBOX_DIR=/opt/ticket-checker/inbox
# PROCESSED_DIR=/opt/ticket-checker/inbox/processed
# FRONTEND_DIR=/opt/ticket-checker/frontend

# Optional: point at a JSON file overriding the PDF parser regex/strategy once you have
# a sample ticket. See backend/config.py DEFAULT_PARSER_CONFIG for the shape.
# PARSER_CONFIG_PATH=/opt/ticket-checker/parser_config.json
