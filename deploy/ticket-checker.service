[Unit]
Description=Cable Car Ticket Checker (data layer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ticketchecker
Group=ticketchecker
WorkingDirectory=/opt/ticket-checker
EnvironmentFile=/opt/ticket-checker/.env
ExecStart=/opt/ticket-checker/venv/bin/uvicorn backend.app:app --host ${HOST} --port ${PORT}
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ticket-checker

[Install]
WantedBy=multi-user.target
